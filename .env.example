# 这个文件现在是"可选"的。
#
# 正常使用不需要编辑任何配置文件：启动后打开后台界面
#   http://127.0.0.1:4319
# 首次访问会让你设置一个后台密码，之后评判渠道、各平台密钥、题库等
# 全部在界面里配置，保存在 data/config.json。
#
# 只有下面两种情况才需要用到本文件：
#   1. 想用环境变量做首次运行的初始值（例如用 Docker / 脚本部署）
#   2. 想固定后台服务的监听地址和端口
#
# 注意：只有当 data/config.json 还不存在时，这里的值才会被用作初始值；
# 一旦配置文件生成，之后一律以界面里保存的值为准。
#
# 命令统一是 /斜杠命令（/help /start /list /pick /next /status /history /reveal /reset /ask），
# 不需要再配置命令前缀。

# ============ 评判渠道 ============
# gateway（默认，Vercel AI Gateway，内置依赖）| typesafe（官方直连）| custom（第三方转发的 Jev）
JUDGE_PROVIDER=gateway

# Vercel AI Gateway（默认渠道，用的是 Jev）
AI_GATEWAY_API_KEY=your-vck-key-here
JEV_MODEL=typesafe-ai/jev

# TypeSafe 官方直连（需要早期访问资格）
TYPESAFE_API_KEY=

# 评判参数
WIN_THRESHOLD=0.8
YES_THRESHOLD=0.5

# ============ Discord ============
DISCORD_ENABLED=true
DISCORD_TOKEN=your-discord-bot-token-here

# ============ QQ · NapCat (OneBot v11) ============
QQ_ENABLED=true
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# ============ QQ · 官方机器人（QQ 开放平台）============
QQ_OFFICIAL_ENABLED=false
QQ_BOT_APPID=
QQ_BOT_SECRET=
QQ_BOT_SANDBOX=true

# ============ 出站代理（可选）============
# 连不上 Discord / 评判接口时用：填了 PROXY_URL 就等于启用代理。
# 只支持 HTTP/HTTPS 代理（Clash / FlClash 的混合端口就是 HTTP 代理），SOCKS5 请改用 TUN 模式。
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
# 这些地址直连，逗号分隔，支持 *.example.com；留空表示所有地址都走代理
PROXY_BYPASS=localhost,127.0.0.1,::1,0.0.0.0

# ============ 后台服务 ============
# 默认只监听 127.0.0.1（回环），局域网内其它机器访问不到
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4319
