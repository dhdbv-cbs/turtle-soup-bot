# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会提交到仓库。
# 启动时会校验下面的取值，非法值会打印具体原因并拒绝启动。

# ============ Jev 评判模型 ============
# Vercel AI Gateway API Key
AI_GATEWAY_API_KEY=your-vck-key-here
JEV_MODEL=typesafe-ai/jev
# 玩家发言与谜底相似度 >= 此值判定通关（0~1）
WIN_THRESHOLD=0.8
# Jev 判定"是"的概率阈值（0~1）
YES_THRESHOLD=0.5

# ============ Discord ============
DISCORD_ENABLED=true
DISCORD_TOKEN=your-discord-bot-token-here
# 命令前缀
DISCORD_PREFIX=!

# ============ QQ (OneBot v11 反向 WebSocket) ============
# 配合 NapCat / Lagrange / LLOneBot 等 OneBot 实现使用
QQ_ENABLED=true
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=
# QQ 命令前缀
QQ_PREFIX=#

# ============ 后台管理 API（导入题目）============
# 监听地址：默认只监听 127.0.0.1（回环），局域网内其它机器访问不到
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4319
# 导入题目时的简易令牌（留空则不校验，不建议留空）
ADMIN_TOKEN=
